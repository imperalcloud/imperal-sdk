{
  "$defs": {
    "NeedsHumanModel": {
      "additionalProperties": false,
      "description": "Structured marker for an obstacle only the human can resolve.\n\n``source`` is intentionally omitted here \u2014 the kernel attaches the\nauthoritative origin at the dispatch boundary and quotes ``what``\nto the human without trusting self-declared sources.",
      "properties": {
        "what": {
          "minLength": 1,
          "title": "What",
          "type": "string"
        },
        "kind": {
          "enum": [
            "means",
            "fact",
            "decision"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "what",
        "kind"
      ],
      "title": "NeedsHumanModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical return-value contract for every @chat.function. Produced by `ActionResult.to_dict()`; consumed by the Imperal kernel executor, Temporal activity history, automation template resolver, and SSE delivery.",
  "properties": {
    "status": {
      "enum": [
        "success",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "needs_human": {
      "anyOf": [
        {
          "$ref": "#/$defs/NeedsHumanModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "ui": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ui"
    },
    "refresh_panels": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Refresh Panels"
    }
  },
  "required": [
    "status"
  ],
  "title": "Imperal ActionResult Payload",
  "type": "object",
  "$id": "https://imperal.io/schemas/action_result.schema.json"
}
